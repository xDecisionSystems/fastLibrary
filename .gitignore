# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtualenv
.venv/
venv/
env/

# Environment
.env
.env.*
!.env.example

# PDFs and data
pdf/
*.pdf

# Venue JSON store (local data, not committed)
venues/*.json

# Downloads folder (track folder, ignore contents)
downloads/**
!downloads/.gitkeep

# Task progress files (runtime state, not committed)
tasks/**
!tasks/.gitkeep
